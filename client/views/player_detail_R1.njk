{% include 'parts/player_detail_R1/head_and_pc_styles.njk' %}{% include 'parts/player_detail_R1/mobile_styles.njk' %}{% macro format_avg(h, ab) %}{% if ab > 0 %}{% set a = h / ab %}{% set v = "%.3f"|format(a) %}{% if a < 1 %}.{{ sliceText(v, 2) }}{% else %}{{ v }}{% endif %}{% else %}.000{% endif %}{% endmacro %}
{% include 'parts/player_detail_R1/stats_separator.njk' %}{% macro render_score_board(label, ab, hits, style_override="", class_extra="") %}
    {% set ab = ab|int %}
    {% set hits = hits|int %}
    {% set avg = (hits / ab) if ab > 0 else 0.0 %}
    {% set class_name = 'hot-zone' if avg >= 0.3 and ab > 0 else ('cold-zone' if avg < 0.2 and ab > 0 else '') %}
    <div class="stat-box {{ class_name }} {{ class_extra }}" style="{{ style_override }}">
        <div class="box-label">{{ label }}</div>
        <div class="box-rate">{{ format_avg(hits, ab) }}</div>
        <div class="box-detail">{{ ab }}-{{ hits }}</div>
    </div>
{% endmacro %}
{% include 'parts/player_detail_R1/situations_separator.njk' %}{% set st = namespace(
    dir_left_ab=0, dir_left_h=0, dir_center_ab=0, dir_center_h=0, dir_right_ab=0, dir_right_h=0,
    run0_ab=0, run0_h=0, run1_ab=0, run1_h=0, run2_ab=0, run2_h=0, run3_ab=0, run3_h=0,
    run12_ab=0, run12_h=0, run13_ab=0, run13_h=0, run23_ab=0, run23_h=0, runF_ab=0, runF_h=0,
    total_ab=0, total_h=0, total_hr=0
) %}
{% include 'parts/player_detail_R1/plate_stats_and_pc_header.njk' %}{% macro colored_name(fname, player) -%}
{%- set ns = namespace(colors=[]) -%}
{%- for key in ['pos1', 'pos2', 'pos3'] -%}
  {%- set pos = (player.get(key, '') or '')|string|trim -%}
  {%- if pos -%}
    {%- set cur = namespace(c='') -%}
    {%- if pos in ['投', '投手'] -%}{%- set _ = setAttr(cur, "c", '#ff7eae') -%}
    {%- elif pos in ['捕', '捕手'] -%}{%- set _ = setAttr(cur, "c", '#5ec8f5') -%}
    {%- elif pos in ['一', '二', '三', '遊', '内', '内野'] -%}{%- set _ = setAttr(cur, "c", '#ffe14a') -%}
    {%- elif pos in ['左', '中', '右', '外', '外野'] -%}{%- set _ = setAttr(cur, "c", '#7ed957') -%}
    {%- elif pos in ['DH', 'ＤＨ'] -%}{%- set _ = setAttr(cur, "c", '#ffb020') -%}
    {%- endif -%}
    {%- if cur.c and (ns.colors|length == 0 or ns.colors[-1] != cur.c) -%}
      {%- set _ = setAttr(ns, "colors", concat(ns.colors, [cur.c])) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- set n = ns.colors|length -%}
{%- set shown = (fname[0] ~ '　' ~ fname[1]) if fname|length == 2 else fname -%}
{%- if n > 0 -%}
{%- set band = namespace(bits=[]) -%}
{%- for c in ns.colors -%}
  {%- set _ = setAttr(band, "bits", concat(band.bits, [c ~ ' ' ~ (loop.index0 * 100 / n) ~ '% ' ~ (loop.index * 100 / n) ~ '%'])) -%}
{%- endfor -%}
<span class="name-fill" style="background-image:linear-gradient(90deg, {{ band.bits|join(', ') }})"></span>
{%- endif -%}
<span class="name-letters">{{ shown }}</span>
{%- endmacro %}
                    {% set fname = player['name'].split(' ')[0] %}
