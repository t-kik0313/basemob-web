            if (['K', 'BB', 'HBP'].includes(selectObj.value)) {
                dirSelect.value = ''; 
                dirSelect.style.pointerEvents = 'none'; 
                dirSelect.style.backgroundColor = '#e9ecef'; 
                dirSelect.style.color = '#999';
            } else {
                dirSelect.style.pointerEvents = 'auto'; 
                dirSelect.style.backgroundColor = '#fff';
                dirSelect.style.color = '#333';
            }
        }

        function addAtBat() {
            const tbody = document.getElementById('atBatsBody');
            const rowCount = tbody.querySelectorAll('tr').length + 1;
            const newRow = document.createElement('tr');

            newRow.innerHTML = `
                <td class="row-num">${rowCount}</td>
                <td>
                    <select name="result[]" onchange="toggleDirection(this)">
                        <option value="O">凡退</option>
                        <option value="1B">単打</option>
                        <option value="2B">二塁打</option>
                        <option value="3B">三塁打</option>
                        <option value="HR">本塁打</option>
                        <option value="K">三振</option>
                        <option value="BB">四球</option>
                        <option value="HBP">死球</option>
                        <option value="SF">犠飛</option>
                        <option value="SH">犠打</option>
                        <option value="E">敵失</option>
                        <option value="FC">野選</option>
                    </select>
                </td>
                <td>
                    <select name="direction[]" style="background: #fff;">
                        <option value="">-</option>
                        <option value="1">投</option><option value="2">捕</option><option value="3">一</option>
                        <option value="4">二</option><option value="5">三</option><option value="6">遊</option>
                        <option value="7">左</option><option value="8">中</option><option value="9">右</option>
                    </select>
                </td>
                <td>
                    <select name="runner[]">
                        <option value="0">なし</option><option value="1">1塁</option><option value="2">2塁</option>
                        <option value="3">3塁</option><option value="1.2">1・2塁</option><option value="1.3">1・3塁</option>
                        <option value="2.3">2・3塁</option><option value="F">満塁</option>
                    </select>
                </td>
                <td>
                    <select name="s${rowCount}">
                        <option value="0">0</option><option value="1">1</option><option value="2">2</option>
                    </select>
                </td>
                <td>
                    <input type="hidden" name="vs_left[]" value="0">
                    <input type="checkbox" onchange="this.previousElementSibling.value = this.checked ? '1' : '0'">
                </td>
                <td>
                    <input type="hidden" name="sayonara[]" value="0">
                    <input type="checkbox" onchange="this.previousElementSibling.value = this.checked ? '1' : '0'">
                </td>
                
                <input type="hidden" name="bases[]" value="1">
                <input type="hidden" name="advancing_runner[]" value="0">
                <input type="hidden" name="multi_hit[]" value="0">
            `;
            tbody.appendChild(newRow);
            
            const resultSelect = newRow.querySelector('select[name="result[]"]');
            toggleDirection(resultSelect);
        }
    </script>
</body>
</html>