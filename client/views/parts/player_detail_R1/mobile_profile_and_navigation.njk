                {{ colored_name(fname, player) }}
            </div>
            <div class="mob-logo-block"><img src="/static/uniform.jpeg"></div>
            <div class="mob-number-block">{{ player['number'] }}</div>
        </div>
        <div class="mob-pos-row">
            <span class="mob-label-pill">守備位置</span>
            <span class="mob-pos-val">
                {{ player['pos1'] }} 
                {% if player['pos2'] %}{{ player['pos2'] }}{% endif %} 
                {% if player['pos3'] %}{{ player['pos3'] }}{% endif %}
            </span>
        </div>

        <div class="mob-photo-block">
            <img src="{{ url_for('static', filename=player.get('image_path', 'default.png')) }}">
        </div>

        <div class="mob-info-row">
            <span class="mob-label-pill">成 績</span>
            <span class="mob-info-val">率{{ format_avg(annual_h, annual_ab) }}　{{ annual_hr }}本　{{ annual_rbi }}点　{{ annual_sb }}盗</span>
        </div>
        <div class="mob-info-row">
            <span class="mob-label-pill">性 格</span>
            <span class="mob-info-val-s" style="margin-right:auto;">{{ player.get('character', 'ふつう') }}</span>
            <span class="mob-label-pill">投 打</span>
            <span class="mob-info-val-s">{{ player.get('pitch_bat', '右投右打') }}</span>
        </div>

        {% set dan = player.get('dan', 2)|int %}
        {% set dan = dan if dan >= 1 and dan <= 4 else 2 %}
        <div class="mob-ability-row" style="margin-top:15px;">
            <span class="mob-ability-label">弾　道</span>
            <span class="dan-mark">
                <img src="{{ url_for('static', filename='trajectory/arrow_' ~ dan ~ '.png') }}" alt="">
                <span class="dan-num">{{ dan }}</span>
            </span>
        </div>
        {% for attr, label, key in [['meet', 'ミート', 'meet_val'], ['power', 'パワー', 'power_val'], ['speed', '走力', 'speed_val'], ['arm', '肩力', 'arm_val'], ['defense', '守備力', 'defense_val'], ['catching', '捕球', 'catch_val']] %}
        <div class="mob-ability-row">
            <span class="mob-ability-label">{{ label }}</span>
            <span class="mob-ability-rank rank-{{ attr }}">-</span>
            <span class="mob-ability-val val-display-{{ attr }}">{{ player.get(key, 50) }}</span>
        </div>
        {% endfor %}

        <div class="mob-slider-section" id="mob-ability-view" style="position: relative; border: 2px solid transparent; transition: border-color 0.3s, background-color 0.3s;">
            <button type="button" id="mob-edit-ability-btn" onclick="toggleEditMode(true)" style="position: absolute; top: -5px; right: -5px; z-index: 30; background: none; border: none; font-size: 1.4rem; color: #64748b; cursor: pointer; padding: 5px;" title="編集する">
                <i class="fa-solid fa-gear hover:text-blue-600 transition-colors"></i>
            </button>
            <button type="button" id="mob-save-ability-btn" onclick="saveAbilities({{ player['id'] }})" style="position: absolute; top: -5px; right: -5px; z-index: 30; background: none; border: none; font-size: 1.4rem; color: #10b981; cursor: pointer; padding: 5px; display: none;" title="保存して完了">
                <i class="fa-solid fa-circle-check hover:text-green-700 transition-colors"></i>
            </button>

            <div class="mob-age-row" style="padding-top: 5px;">
                <div class="mob-age-box"><span class="l">年齢</span><span class="v">{{ player.get('age', 25) }}</span></div>
                <div class="mob-age-box"><span class="l">年齢ポイント</span>
                    <span class="vp hold-point-display">{{ age_pts if age_pts > 0 else 0 }}</span>
                </div>
            </div>
            <div class="mob-sliders-grid">
                {% for attr, label in [['meet', 'ミート'], ['power', 'パワー'], ['speed', '走力'], ['arm', '肩力'], ['defense', '守備力'], ['catching', '捕球']] %}
                <div class="mob-slider-box">
                    <div class="mob-slider-header">
                        <span>{{ label }}</span>
                        <span class="plus-val plus-val-{{ attr }}">+{{ player.get('plus_' + attr, 0) | default(0, true) | int }}</span>
                    </div>
                    <input type="range" class="ability-slider" data-attr="{{ attr }}" min="0" max="16" value="{{ player.get('plus_' + attr, 0) | default(0, true) | int }}" disabled>
                </div>
                {% endfor %}
            </div>
        </div>

        <div style="margin-top:15px;">
            <div class="mob-spec-grid">
                <div class="mob-spec-item"><span class="s-label">チャンス</span><span class="s-rank rank-{{ player.get('chance_rank', 'D') }}">{{ player.get('chance_rank', 'D') }}</span></div>
                <div class="mob-spec-item"><span class="s-label">対左投手</span><span class="s-rank rank-{{ player.get('left_rank', 'D') }}">{{ player.get('left_rank', 'D') }}</span></div>
                <div class="mob-spec-item"><span class="s-label spec-label-keep">ｹｶﾞしにくさ</span><span class="s-rank rank-{{ player.get('injury', 'D') }}">{{ player.get('injury', 'D') }}</span></div>
                <div class="mob-spec-item"><span class="s-label">盗　塁</span><span class="s-rank rank-{{ player.get('steal_rank', 'D') }}">{{ player.get('steal_rank', 'D') }}</span></div>
            </div>
            <div class="mob-spec-grid" style="margin-bottom:10px;">
                <div class="mob-spec-item"><span class="s-label">走　塁</span><span class="s-rank rank-{{ player.get('run_rank', 'D') }}">{{ player.get('run_rank', 'D') }}</span></div>
                <div class="mob-spec-item"><span class="s-label">送　球</span><span class="s-rank rank-{{ player.get('throw', 'D') }}">{{ player.get('throw', 'D') }}</span></div>
                <div class="mob-spec-item" style="background:#f9fafb;"></div>
                <div class="mob-spec-item"><span class="s-label">回　復</span><span class="s-rank rank-{{ player.get('recovery', 'D') }}">{{ player.get('recovery', 'D') }}</span></div>
            </div>

            <div class="mob-active-skill-grid">
                {% for skill_name, s_type in active_skills %}
                    <div class="mob-active-skill skill-{{ s_type }}">{{ skill_name }}</div>
                {% endfor %}
                {% for i in range(12 - active_skills|length) %}
                    <div class="mob-active-skill skill-empty"></div>
                {% endfor %}
            </div>
        </div>

                <div class="mob-btn-wrap">
            <a href="/current_year_stats/{{ player['player_id'] }}" class="mob-nav-btn">今年度個人成績</a>
            <a href="/record_summary" class="mob-nav-btn">記録まとめ</a>
            <a href="/player_history/{{ player['player_id'] }}" class="mob-nav-btn">通算成績</a>
            <a href="/pitchers" class="mob-nav-btn">投手成績</a>
            <a href="/input_form_R1/{{ player['player_id'] }}" class="mob-nav-btn">入力フォーム</a>
            <a href="/pawapuro" class="mob-nav-btn" style="flex-grow:1;">パワプロ風</a>
            <a href="/edit_player/{{ player['player_id'] }}" class="mob-nav-btn edit" style="flex-grow:1;">編集</a>

