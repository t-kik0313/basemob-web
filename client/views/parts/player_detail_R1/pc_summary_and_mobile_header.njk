                <button type="button" id="save-ability-btn" onclick="saveAbilities({{ player['id'] }})" style="position: absolute; top: -5px; right: -5px; z-index: 30; background: none; border: none; font-size: 1.4rem; color: #10b981; cursor: pointer; padding: 5px; display: none;" title="保存して完了">
