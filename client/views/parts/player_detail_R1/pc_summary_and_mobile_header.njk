                    <div class="pc-status-box" style="margin-left:0; align-items:stretch;">
                        <div style="display:flex; justify-content:space-between; width:100%; color:#000; font-weight:bold;">
                            <span>{{ label }}</span>
                            <span class="plus-val-{{ attr }}" style="color:#1e90ff; font-weight:bold;">+{{ player.get('plus_' + attr, 0) | default(0, true) | int }}</span>
                        </div>
                        <input type="range" class="ability-slider" data-attr="{{ attr }}" min="0" max="16" value="{{ player.get('plus_' + attr, 0) | default(0, true) | int }}" disabled>
                    </div>
                    {% endfor %}
                </div>
            </div>
