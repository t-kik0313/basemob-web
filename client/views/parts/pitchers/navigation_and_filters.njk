            background-color: #286090;
        }

        /* テーブルデザイン */
        .table-container {
            overflow-x: auto;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .stats-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px; /* 項目が多いのでPC向けの幅を広めに確保 */
            text-align: center;
            font-size: 13px; /* 項目が多いので文字を少しだけ小さく */
        }
        
        .stats-table th {
            background-color: #f8f9fa;
            color: #333;
            padding: 12px 8px;
            font-weight: 600;
            border-bottom: 2px solid #ddd;
            border-top: 1px solid #ddd;
            white-space: nowrap;
        }
        
        .stats-table td {
            padding: 12px 8px;
            border-bottom: 1px solid var(--border-color);
            color: #444;
        }
        
        .stats-table tbody tr:hover { background-color: #eef2f7; }
        
        .player-name {
            text-align: left !important;
            font-weight: bold;
            color: var(--primary-color);
            white-space: nowrap;
            position: sticky;
            left: 0;
            background-color: #fff;
            border-right: 2px solid #eee;
        }
        /* スクロール時に見やすくするための設定 */
        .stats-table tbody tr:hover .player-name { background-color: #eef2f7; }

        /* スマホ対応 */
        @media (max-width: 768px) {
            .filter-select { flex: 100%; }
        }
    </style>
</head>
