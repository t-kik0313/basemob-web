
    {% for r in records %}
        {% set res_str = r.result|string %}
        {% set is_ab = res_str in ab_results %}
        {% set is_h = res_str in hit_results %}

        {% if is_ab %}
            {% set _ = setAttr(count, "all_ab", count.all_ab + 1) %}
            {% if is_h %}{% set _ = setAttr(count, "all_h", count.all_h + 1) %}{% endif %}

            {% set dir_str = r.direction|string|replace('.0', '') %}
            {% if dir_str in pull_dirs %}{% set _ = setAttr(count, "pull_ab", count.pull_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "pull_h", count.pull_h + 1) %}{% endif %}{% endif %}
            {% if dir_str in push_dirs %}{% set _ = setAttr(count, "push_ab", count.push_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "push_h", count.push_h + 1) %}{% endif %}{% endif %}
            
            {% set runner = r.runner|string|replace('.0', '') %}
            {% if runner in no_runners %}{% set _ = setAttr(count, "norun_ab", count.norun_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "norun_h", count.norun_h + 1) %}{% endif %}{% endif %}
            {% if runner in loaded_runners %}{% set _ = setAttr(count, "loaded_ab", count.loaded_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "loaded_h", count.loaded_h + 1) %}{% endif %}{% endif %}
            
            {% if runner in risp_runners %}
                {% set _ = setAttr(count, "risp_ab", count.risp_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "risp_h", count.risp_h + 1) %}{% endif %}
            {% else %}
                {% set _ = setAttr(count, "nonrisp_ab", count.nonrisp_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "nonrisp_h", count.nonrisp_h + 1) %}{% endif %}
            {% endif %}

            {% if r.strikes|string in ['0', '0.0'] %}{% set _ = setAttr(count, "s0_ab", count.s0_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "s0_h", count.s0_h + 1) %}{% endif %}{% endif %}
            {% if r.strikes|string in ['2', '2.0'] %}{% set _ = setAttr(count, "s2_ab", count.s2_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "s2_h", count.s2_h + 1) %}{% endif %}{% endif %}
            
            {% if r.is_official|string == '1' or r.game_type == 'official' %}{% set _ = setAttr(count, "off_ab", count.off_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "off_h", count.off_h + 1) %}{% endif %}{% endif %}
            {% if r.vs_left|string == '1' %}{% set _ = setAttr(count, "left_ab", count.left_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "left_h", count.left_h + 1) %}{% endif %}{% endif %}
            {% if r.is_4th_bat|string == '1' or r.batting_order|string in ['4', '4.0'] %}{% set _ = setAttr(count, "bat4_ab", count.bat4_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "bat4_h", count.bat4_h + 1) %}{% endif %}{% endif %}

            {% if r.stadium|string in ['1', '1.0'] %}{% set _ = setAttr(count, "st1_ab", count.st1_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "st1_h", count.st1_h + 1) %}{% endif %}{% endif %}
            {% if r.stadium|string in ['2', '2.0'] %}{% set _ = setAttr(count, "st2_ab", count.st2_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "st2_h", count.st2_h + 1) %}{% endif %}{% endif %}
            {% if r.stadium|string in ['3', '3.0'] %}{% set _ = setAttr(count, "st3_ab", count.st3_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "st3_h", count.st3_h + 1) %}{% endif %}{% endif %}
            {% if r.stadium|string in ['4', '4.0'] %}{% set _ = setAttr(count, "st4_ab", count.st4_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "st4_h", count.st4_h + 1) %}{% endif %}{% endif %}
            {% if r.stadium|string in ['5', '5.0'] %}{% set _ = setAttr(count, "st5_ab", count.st5_ab + 1) %}{% if is_h %}{% set _ = setAttr(count, "st5_h", count.st5_h + 1) %}{% endif %}{% endif %}
        {% endif %}
    {% endfor %}

    <!-- 🌟 自動判定システム：固め打ち（マルチヒット）の計算 -->

