<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ team_name }} イベント</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='events.css') }}?v=12">
</head>
<body class="{{ 'member' if logged_in else 'public' }}">
    <div class="nav-header">
        <a href="{{ url_for('players') }}" class="btn-back">トップページへ戻る</a>
    </div>
    <div class="page" id="app"></div>
    <script>
        window.EVENTS_BOOT = {{ {
            'readApi': url_for('api_events'),
            'pollApi': url_for('api_events'),
            'loggedIn': logged_in,
            'scheduleUrl': url_for('schedule'),
            'roster': roster
        } | tojson }};
    </script>
    <script src="{{ url_for('static', filename='events.js') }}?v=14"></script>
</body>
</html>
