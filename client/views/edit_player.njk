<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>選手情報編集</title>
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f7f9; margin: 0; padding: 20px; }
        .container { max-width: 500px; margin: 0 auto; background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        h2 { text-align: center; color: #333; font-size: 1.5rem; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; color: #555; }
        input[type="text"], input[type="number"], select, input[type="file"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; font-size: 1rem; background: #fff; }
        .file-hint { margin: 6px 0 0; font-size: 0.85rem; color: #666; }
        .image-preview { display: block; width: 120px; height: 90px; margin-top: 10px; object-fit: cover; border-radius: 6px; border: 1px solid #ccc; background: #eee; }
        .form-error { background: #fdecea; color: #b71c1c; border-radius: 5px; padding: 10px 12px; margin: 0 0 15px; }
        .btn-submit { width: 100%; padding: 12px; background-color: #1e90ff; color: white; border: none; border-radius: 5px; font-size: 1.1rem; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .btn-cancel { display: block; text-align: center; margin-top: 15px; color: #666; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <h2>選手情報編集 ({{ player.name }})</h2>
        <form method="POST" enctype="multipart/form-data">
            {% if error %}
            <p class="form-error">{{ error }}</p>
            {% endif %}
            <div class="form-group">
                <label>名前</label>
                <input type="text" name="name" value="{{ player.name }}" required>
            </div>
            <div class="form-group">
                <label>背番号</label>
                <input type="number" name="number" value="{{ player.number }}">
            </div>
            
            <div class="form-group">
                <label>メインポジション</label>
                <select name="pos1">
                    <option value="">未設定</option>
                    {% for p in ['投','捕','一','二','三','遊','左','中','右'] %}
                        <option value="{{ p }}" {% if player.pos1 == p %}selected{% endif %}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label>サブポジション 1</label>
                <select name="pos2">
                    <option value="">未設定</option>
                    {% for p in ['投','捕','一','二','三','遊','左','中','右'] %}
                        <option value="{{ p }}" {% if player.pos2 == p %}selected{% endif %}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label>サブポジション 2</label>
                <select name="pos3">
                    <option value="">未設定</option>
                    {% for p in ['投','捕','一','二','三','遊','左','中','右'] %}
                        <option value="{{ p }}" {% if player.pos3 == p %}selected{% endif %}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label>投打</label>
                <select name="pitch_bat">
                    {% for pb in ['右投右打','右投左打','右投両打','左投左打','左投右打','左投両打'] %}
                        <option value="{{ pb }}" {% if player.pitch_bat == pb %}selected{% endif %}>{{ pb }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label>生年月日 (YYYY-MM-DD)</label>
                <input type="text" name="birth_date" value="{{ player.birth_date | default('', true) }}">
            </div>

            <div class="form-group">
                <label for="image_path">画像パス</label>
                <input type="text" id="image_path" name="image_path" value="{{ player.image_path }}">
                <p class="file-hint">static フォルダからの相対パスです。例: 13_matsushita.jpg</p>
            </div>
            <div class="form-group">
                <label for="image">新しい画像</label>
                <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif">
                <p class="file-hint">フォルダから選んで保存すると、画像をアップロードして画像パスを更新します。</p>
                <img id="image-preview" class="image-preview" alt="" src="{{ url_for('static', filename=player.image_path or 'default.png') }}">
            </div>

            <button type="submit" class="btn-submit">保存して戻る</button>
            <a href="{{ url_for('player_detail_R1', player_id=player.player_id) }}" class="btn-cancel">キャンセル</a>
        </form>
    </div>
    <script>
        document.getElementById('image').addEventListener('change', function () {
            const preview = document.getElementById('image-preview');
            const file = this.files && this.files[0];
            if (!file) return;
            preview.src = URL.createObjectURL(file);
        });
    </script>
</body>
</html>